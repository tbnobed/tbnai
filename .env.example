# ══════════════════════════════════════════════════════════════════════════════
# Book Archive RAG Tool — Environment Variables
# Copy this file to .env and fill in all required values before running.
# ══════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=archive
POSTGRES_PASSWORD=changeme           # REQUIRED — change before production
POSTGRES_DB=archive_db
POSTGRES_PORT=5432                   # host port mapped to the db container

# ── Authentication (self-hosted) ──────────────────────────────────────────────
# Random string used to sign login session cookies. Generate one with:
#   openssl rand -hex 32
SESSION_SECRET=changeme              # REQUIRED — change before production

# The admin account. Created/updated automatically when the server starts.
# Changing ADMIN_PASSWORD here and restarting updates the password.
# The admin can invite staff members from the Admin page.
ADMIN_EMAIL=admin@example.com        # REQUIRED
ADMIN_PASSWORD=changeme              # REQUIRED — change before production

# ── Local LLM — OpenAI-compatible endpoint (DGX Spark) ───────────────────────
# The base URL of your locally running inference server.
# e.g. http://dgx-spark.local:8080/v1  or  http://192.168.1.50:8080/v1
# If Ollama runs on the same machine as Docker: http://host.docker.internal:11434/v1
OPENAI_BASE_URL=http://your-dgx-spark-host:8080/v1   # REQUIRED
OPENAI_API_KEY=local                 # Leave as "local" if no key is required

# ── Model configuration ───────────────────────────────────────────────────────
CHAT_MODEL=gpt-oss-120b              # Chat/completion model served by the local endpoint
EMBEDDING_MODEL=text-embedding-3-small  # Embedding model served by the local endpoint
EMBEDDING_DIMENSIONS=1536            # Must match the embedding model's output dimensions.
                                     # Common values: 1536 (OpenAI ada-002), 768 (many open models)
                                     # !! Changing this after ingestion requires re-creating the DB !!

# ── RAG tuning ────────────────────────────────────────────────────────────────
RAG_TOP_K=8                          # Number of chunks retrieved per query
RAG_MIN_SIMILARITY=0.3               # Minimum cosine similarity threshold (0–1)

# ── Ingest tuning ─────────────────────────────────────────────────────────────
INGEST_CHUNK_SIZE=600                # Target words per chunk
INGEST_CHUNK_OVERLAP=100             # Overlap words between consecutive chunks
INGEST_EMBED_BATCH=10                # Chunks embedded per API batch call

# ── Book files ────────────────────────────────────────────────────────────────
# Host directory containing your book PDFs / text files.
# This is bind-mounted into the API container as /books/.
# Register a book with filePath: /books/my-book.pdf
BOOKS_DIR=./books

# ── Ports ─────────────────────────────────────────────────────────────────────
WEB_PORT=80                          # Public-facing web port

# ── SendGrid (staff invite emails) ───────────────────────────────────────────
# Obtain from https://app.sendgrid.com → Settings → API Keys
SENDGRID_API_KEY=SG.xxx              # REQUIRED for invite emails
SENDGRID_FROM_EMAIL=noreply@obedtv.com  # REQUIRED — must be a verified sender in SendGrid
SENDGRID_FROM_NAME=Archive Search    # Display name on outgoing emails

# ── App public URL (used in invite email links) ───────────────────────────────
# Must be the publicly reachable URL of the web container (no trailing slash)
APP_BASE_URL=https://archive.obedtv.com  # REQUIRED for invite links to work

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info                       # trace | debug | info | warn | error
