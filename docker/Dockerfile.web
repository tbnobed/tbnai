# ── Stage 1: build React + Vite app ────────────────────────────────────────
FROM node:22-slim AS builder

# Build-time args — passed from docker-compose build.args
ARG BASE_PATH="/"

RUN corepack enable && corepack prepare pnpm@latest --activate

WORKDIR /app

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json tsconfig.json ./
COPY lib/api-zod/package.json        lib/api-zod/
COPY lib/api-zod/tsconfig.json       lib/api-zod/
COPY lib/api-client-react/package.json lib/api-client-react/
COPY lib/api-client-react/tsconfig.json lib/api-client-react/
COPY lib/api-spec/package.json       lib/api-spec/
COPY artifacts/archive-search/package.json artifacts/archive-search/

RUN pnpm install --frozen-lockfile --ignore-scripts

COPY lib/api-zod/         lib/api-zod/
COPY lib/api-client-react/ lib/api-client-react/
COPY lib/api-spec/        lib/api-spec/
COPY artifacts/archive-search/ artifacts/archive-search/

ENV BASE_PATH=$BASE_PATH

# PORT and BASE_PATH are required by the Vite config check
ENV PORT=3000

RUN pnpm --filter @workspace/archive-search run build


# ── Stage 2: Nginx static server ────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner

# Remove default config
RUN rm /etc/nginx/conf.d/default.conf

COPY docker/nginx.conf /etc/nginx/conf.d/app.conf

# Copy built assets
COPY --from=builder /app/artifacts/archive-search/dist/public /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
